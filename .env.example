# ── Required: Gemini API key (free at aistudio.google.com) ───────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: enables web search enrichment via Serper ─────────────────────
SERPER_API_KEY=your_serper_api_key_here

# ── Infrastructure (set automatically by docker-compose) ───────────────────
POSTGRES_URL=postgresql://postgres:postgres@db:5432/quarry
REDIS_URL=redis://redis:6379/0

# ── Model override (default: gemini-1.5-flash) ────────────────────────────
# GEMINI_MODEL=gemini-2.0-flash
